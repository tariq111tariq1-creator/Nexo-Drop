{
  "entities": {
    "UserCloudProfile": {
      "title": "User Cloud Profile",
      "description": "Optional Google-authenticated user profile and cross-device preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID matching document ID." },
        "email": { "type": "string", "description": "Google account email address." },
        "displayName": { "type": "string", "description": "Google account display name." },
        "photoUrl": { "type": "string", "description": "Optional profile avatar URL." },
        "preferredSaveMode": { "type": "string", "description": "APP_DOWNLOADS | CUSTOM_TREE | CATEGORY_SMART | PRIVATE_VAULT" },
        "preferredThemeMode": { "type": "string", "description": "SYSTEM | LIGHT | DARK | AMOLED" },
        "stripExifOnSend": { "type": "boolean", "description": "Whether EXIF metadata is stripped before sending photos." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "preferredSaveMode", "preferredThemeMode", "stripExifOnSend", "createdAt", "updatedAt"]
    },
    "RegisteredDevice": {
      "title": "Registered Device",
      "description": "A device linked to the signed-in user's Google account.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "deviceId": { "type": "string", "description": "Unique NexoDrop installation device identifier." },
        "deviceName": { "type": "string", "description": "Human-readable display name of the device." },
        "model": { "type": "string", "description": "Android hardware device model." },
        "platformVersion": { "type": "integer", "description": "Android SDK_INT version." },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "deviceId", "deviceName", "model", "platformVersion", "lastActiveAt", "createdAt", "updatedAt"]
    },
    "SyncedTransferRecord": {
      "title": "Synced Transfer Record",
      "description": "Cross-device cloud mirror of P2P transfer history metadata.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "deviceId": { "type": "string", "description": "Source device identifier." },
        "deviceName": { "type": "string", "description": "Source device display name." },
        "fileName": { "type": "string", "description": "Transferred file name." },
        "fileSize": { "type": "integer", "description": "File size in bytes." },
        "mimeType": { "type": "string", "description": "MIME type." },
        "category": { "type": "string", "description": "IMAGE | VIDEO | AUDIO | DOCUMENT | ARCHIVE | APP | OTHER" },
        "direction": { "type": "string", "description": "SENT | RECEIVED" },
        "peerDeviceName": { "type": "string", "description": "Remote peer device name." },
        "groupName": { "type": "string", "description": "Group session name." },
        "status": { "type": "string", "description": "COMPLETED | FAILED | CANCELLED | IN_PROGRESS" },
        "sha256": { "type": "string", "description": "Optional file SHA-256 hex digest." },
        "transferredAt": { "type": "integer", "description": "Epoch millis when transfer recorded." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "deviceId", "deviceName", "fileName", "fileSize", "mimeType", "category", "direction", "peerDeviceName", "groupName", "status", "sha256", "transferredAt", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserCloudProfile" },
      "description": "Owner-only cloud profile and synced settings for signed-in NexoDrop users."
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/RegisteredDevice" },
      "description": "Devices belonging to the signed-in user for cross-device recognition."
    },
    "/users/{userId}/synced_transfers/{recordId}": {
      "schema": { "$ref": "#/entities/SyncedTransferRecord" },
      "description": "Cloud-synced transfer history entries scoped strictly to the signed-in user."
    }
  }
}
