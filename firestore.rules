rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        !id.matches('.*[/\\\\].*') &&
        !id.matches('^\\.\\.?$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSaveMode(mode) {
      return mode in ['APP_DOWNLOADS', 'CUSTOM_TREE', 'CATEGORY_SMART', 'PRIVATE_VAULT'];
    }

    function isValidThemeMode(mode) {
      return mode in ['SYSTEM', 'LIGHT', 'DARK', 'AMOLED'];
    }

    function isValidCategory(cat) {
      return cat in ['IMAGE', 'VIDEO', 'AUDIO', 'DOCUMENT', 'ARCHIVE', 'APP', 'OTHER'];
    }

    function isValidDirection(dir) {
      return dir in ['SENT', 'RECEIVED'];
    }

    function isValidStatus(status) {
      return status in ['COMPLETED', 'FAILED', 'CANCELLED', 'IN_PROGRESS'];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'preferredSaveMode', 'preferredThemeMode',
          'stripExifOnSend', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoUrl', 'preferredSaveMode',
          'preferredThemeMode', 'stripExifOnSend', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == userId &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        isValidSaveMode(data.preferredSaveMode) &&
        isValidThemeMode(data.preferredThemeMode) &&
        data.stripExifOnSend is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRegisteredDevice(data, userId, deviceId) {
      return data.keys().hasAll([
          'userId', 'deviceId', 'deviceName', 'model', 'platformVersion',
          'lastActiveAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'deviceId', 'deviceName', 'model', 'platformVersion',
          'lastActiveAt', 'createdAt', 'updatedAt'
        ]) &&
        data.userId == userId &&
        data.deviceId == deviceId &&
        data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 80 &&
        data.model is string && data.model.size() >= 1 && data.model.size() <= 80 &&
        data.platformVersion is int && data.platformVersion >= 24 && data.platformVersion <= 100 &&
        data.lastActiveAt is timestamp && data.lastActiveAt <= request.time &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSyncedTransfer(data, userId) {
      return data.keys().hasAll([
          'userId', 'deviceId', 'deviceName', 'fileName', 'fileSize', 'mimeType',
          'category', 'direction', 'peerDeviceName', 'groupName', 'status',
          'sha256', 'transferredAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'deviceId', 'deviceName', 'fileName', 'fileSize', 'mimeType',
          'category', 'direction', 'peerDeviceName', 'groupName', 'status',
          'sha256', 'transferredAt', 'createdAt', 'updatedAt'
        ]) &&
        data.userId == userId &&
        data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 64 &&
        data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 80 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255 &&
        data.fileSize is int && data.fileSize >= 0 &&
        data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 120 &&
        isValidCategory(data.category) &&
        isValidDirection(data.direction) &&
        data.peerDeviceName is string && data.peerDeviceName.size() >= 1 && data.peerDeviceName.size() <= 120 &&
        data.groupName is string && data.groupName.size() <= 120 &&
        isValidStatus(data.status) &&
        data.sha256 is string && data.sha256.size() <= 128 &&
        data.transferredAt is int && data.transferredAt >= 0 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);

      match /devices/{deviceId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(deviceId) &&
          isValidRegisteredDevice(incoming(), userId, deviceId);
        allow update: if isOwner(userId) &&
          isValidRegisteredDevice(incoming(), userId, deviceId) &&
          incoming().userId == existing().userId &&
          incoming().deviceId == existing().deviceId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      match /synced_transfers/{recordId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId) &&
          isValidSyncedTransfer(incoming(), userId);
        allow update: if isOwner(userId) &&
          isValidSyncedTransfer(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
